# My Family Tree: environment template.
# Copy to .env for local development (values below match the Sail containers).
# Staging/production values come from GitHub Environment secrets. Never commit a real .env.

APP_NAME="My Family Tree"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Docker/Sail ports (change if 80 or 5432 are already used on your PC)
APP_PORT=80
VITE_PORT=5173
# Container user (Sail). 1000 works for Docker Desktop on Windows/macOS.
WWWUSER=1000
WWWGROUP=1000
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379

# Password hashing: Argon2id (see docs/architecture/06-security.md)
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=myfamilytree
DB_USERNAME=sail
DB_PASSWORD=password

# Sessions live in PostgreSQL so users can list and revoke their devices.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true wherever the app is served over HTTPS (staging, production). The session
# cookie then gets the __Host- prefix, which needs SESSION_DOMAIN=null and SESSION_PATH=/.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=mft

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local mail is captured by Mailpit: http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@myfamilytree.test"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage. Locally: RustFS container (console http://localhost:9001, sail / password).
# Production: AWS S3 ap-southeast-5 (Malaysia), private bucket.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=myfamilytree-local
AWS_ENDPOINT=http://rustfs:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Sign in with Google (optional). Create an OAuth client at https://console.cloud.google.com
# with the redirect URI {APP_URL}/auth/google/callback. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage each new family starts with, in bytes (default 10 GB).
FAMILY_DEFAULT_STORAGE_QUOTA_BYTES=10737418240

# Family Owners and Administrators must use two-factor authentication. This is off only
# while APP_ENV=local; uncomment to try the requirement on your own machine.
# FAMILY_ADMIN_TWO_FACTOR=true

VITE_APP_NAME="${APP_NAME}"
